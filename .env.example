# ============================================================
# Development Environment (used by docker-compose.dev.yml)
# ============================================================
POSTGRES_USER=typerek
POSTGRES_PASSWORD=typerek_dev
POSTGRES_DB=typerek_development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================
# Production Environment (used by docker-compose.yml)
# ============================================================
# REQUIRED: Uncomment and fill in ALL values marked [REQUIRED] before running docker compose up.
# Failure to set required values will result in broken database connections or missing encryption keys.

# --- PostgreSQL [REQUIRED] ---
# Must match database.yml production username ("backend")
# POSTGRES_USER=backend
# POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
# POSTGRES_DB=backend_production

# --- Rails [REQUIRED] ---
# RAILS_MASTER_KEY=CHANGE_ME_from_backend_config_master_key
# SECRET_KEY_BASE=CHANGE_ME_generate_with_bin_rails_secret
# RAILS_ENV=production
# RAILS_LOG_LEVEL=info

# --- Performance ---
# WEB_CONCURRENCY=2
# RAILS_MAX_THREADS=3
# SOLID_QUEUE_IN_PUMA=true

# --- SSL (set to true when using HTTPS) ---
# RAILS_ASSUME_SSL=false

# --- Host protection (your domain name) ---
# ALLOWED_HOST=typerek.example.com

# --- Ports (defaults: 80/443) ---
# HTTP_PORT=80
# HTTPS_PORT=443
