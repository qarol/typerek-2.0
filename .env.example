# Production Environment — copy to .env and fill in all REQUIRED values
# Dev environment is self-contained in docker-compose.dev.yml and needs no .env

# PostgreSQL [REQUIRED]
POSTGRES_USER=backend
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=backend_production

# Rails [REQUIRED]
RAILS_MASTER_KEY=CHANGE_ME_from_backend_config_master_key
SECRET_KEY_BASE=CHANGE_ME_generate_with_bin_rails_secret

# Performance (optional)
# WEB_CONCURRENCY=2
# RAILS_MAX_THREADS=3

# SSL (set to true when using HTTPS)
# RAILS_ASSUME_SSL=false

# Host protection
# ALLOWED_HOST=typerek.example.com

# Ports
# HTTP_PORT=80
# HTTPS_PORT=443
